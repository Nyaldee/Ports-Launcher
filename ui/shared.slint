
export global Theme {
    in-out property <color> search-background: #404552;
    in-out property <color> search-text: #7c818c;
    in-out property <color> list-background: #383c4a;
    in-out property <color> list-text: #d3dae3;
    in-out property <color> selected-background: #5294e2;
    in-out property <color> selected-text: #ffffff;
    in-out property <color> border-color: #4b5162;
    in-out property <int> border-width: 3;
    in-out property <float> scale-factor: 1.0;
    out property <length> title-button-padding: 10px / scale-factor;
}

export global SemanticColors {
    in-out property <color> selection-border: #ffffff;
    in-out property <color> fallback-text: #d3dae3;
    in-out property <color> card-background: #383c4a;
    in-out property <color> success: #78b159;
    in-out property <color> success-hover: #93c17a;
    in-out property <color> warning: #f4900c;
    in-out property <color> warning-hover: #f6a63d;
    in-out property <color> danger: #dd2e44;
    in-out property <color> danger-hover: #e45869;
    in-out property <color> info: #55acee;
    in-out property <color> info-hover: #77bdf1;
    in-out property <color> text-on-accent: #ffffff;
    in-out property <color> brand-github: #24292f;
    in-out property <color> brand-github-hover: #32383f;
    in-out property <color> brand-discord: #5865f2;
    in-out property <color> brand-discord-hover: #6b76f5;
}

export component TitleBarIconButton inherits Rectangle {
    in property <length> size;
    in property <color> hover-color;
    in property <color> hover-stroke-color;
    in property <string> icon-commands;
    in property <bool> enabled: true;
    callback clicked();

    width: size;
    height: size;
    opacity: enabled ? 1.0 : 0.4;
    background: area.has-hover && enabled ? hover-color : transparent;
    area := TouchArea {
        clicked => {
            if (enabled) {
                root.clicked();
            }
        }
    }
    Path {
        x: 0.5px * (1 - 1 / Theme.scale-factor);
        y: 0.5px * (1 - 1 / Theme.scale-factor);
        width: 100%;
        height: 100%;
        stroke: area.has-hover && enabled ? hover-stroke-color : Theme.list-text;
        stroke-width: size * 0.1;
        stroke-line-cap: round;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: icon-commands;
    }
}

export component InertialScroller {
    width: 0px;
    height: 0px;

    in property <length> min-viewport-y: 0px;
    in-out property <length> viewport-y: 0px;

    property <length> velocity: 0px;
    property <length> last-sample-y: 0px;
    property <duration> last-sample-time: 0ms;
    property <length> min-fling-velocity: 40px;
    property <float> friction: 0.92;

    public pure function clamp-viewport-y(candidate: length, visible-height: length, viewport-height: length) -> length {
        return Math.clamp(candidate, Math.min(0px, visible-height - viewport-height), 0px);
    }

    public function begin-drag(current-y: length) {
        self.velocity = 0px;
        self.last-sample-y = current-y;
        self.last-sample-time = animation-tick();
    }

    public function record-sample(current-y: length) {
        if (animation-tick() > self.last-sample-time) {
            self.velocity = (current-y - self.last-sample-y) / ((animation-tick() - self.last-sample-time) / 1s);
        }
        self.last-sample-y = current-y;
        self.last-sample-time = animation-tick();
    }

    public function release() {
        if (Math.abs(self.velocity) > min-fling-velocity) {
            decay-timer.running = true;
        }
    }

    decay-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            root.velocity *= root.friction;
            root.viewport-y = Math.clamp(root.viewport-y + root.velocity * (16ms / 1s), root.min-viewport-y, 0px);
            let moving = Math.abs(root.velocity) >= root.min-fling-velocity && root.viewport-y > root.min-viewport-y && root.viewport-y < 0px;
            self.running = moving;
            if (!moving) {
                root.velocity = 0px;
            }
        }
    }
}

export component ThemedScrollbar inherits Rectangle {
    in property <length> viewport-height: 1px;
    in property <length> visible-height: 1px;
    in-out property <length> viewport-y: 0px;
    in property <color> thumb-color: Theme.border-color;
    in property <color> thumb-hover-color: thumb-color.brighter(0.2);

    width: 6px / Theme.scale-factor;
    visible: root.viewport-height > root.visible-height;

    property <length> max-scroll: max(1px, root.viewport-height - root.visible-height);
    property <length> thumb-height: max(24px, root.height * root.visible-height / max(root.visible-height, root.viewport-height));
    property <length> thumb-travel: root.height - root.thumb-height;

    function scroll-to(pointer-y: length) {
        root.viewport-y = -max(0px, min(root.max-scroll, (pointer-y - root.thumb-height / 2) * root.max-scroll / root.thumb-travel));
    }

    Rectangle {
        background: track-area.has-hover ? root.thumb-hover-color : root.thumb-color;
        width: root.width;
        height: root.thumb-height;
        y: root.thumb-travel * (-root.viewport-y / root.max-scroll);
    }

    track-area := TouchArea {
        width: root.width;
        height: root.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.scroll-to(self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) {
                root.scroll-to(self.mouse-y);
            }
        }
    }
}
